    },
    {
      "dot": "violet",
      "title": "AI calls",
      "items": [
        "The week is planned in one call",
        "Only failing days are sent for repair",
        "Python does all macro and pack arithmetic"
      ]
    },
    {
      "dot": "amber",
      "title": "Stores",
      "items": [
        "Stores ranked by hard-to-find items they stock",
        "Missing items bought at the next store, up to 3",
        "Each store is a separate cart"
      ]
    },
    {
      "dot": "emerald",
      "title": "Pauses",
      "items": [
