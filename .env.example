# LLM: any OpenAI-compatible endpoint. Pick ONE block and fill it in.
#
# Google Gemini free tier: key at https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=
LLM_MODEL=gemini-3.8-flash
# Tried in order when a model's free quota runs out or it's overloaded.
# "model" = same provider; "provider:model" = groq / cerebras / deepseek / openrouter / ollama / gemini.
# Entries whose provider has no key below are skipped.
LLM_FALLBACKS=gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,groq:openai/gpt-oss-120b
# Groq (https://console.groq.com): free, but only 8,000 tokens/min and per request, so a full
# week is slow. It's the last resort when every Gemini model is out of daily quota.
GROQ_API_KEY=
# Cerebras (https://cloud.cerebras.ai): free, fast; add cerebras:gpt-oss-120b to LLM_FALLBACKS to use it.
CEREBRAS_API_KEY=
# DeepSeek (https://platform.deepseek.com): pay-as-you-go; DS_API_KEY also works.
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
#
# Optional tuning (defaults shown).
# LLM_PREFERRED=                  # a label from LLM_FALLBACKS to try first for everything
# LLM_SHORT_TASKS_FIRST=groq:     # small tasks (store, picks, intake) try this provider first
# LLM_TIMEOUT_S=300               # give up on one model for a week plan after this
# LLM_SHORT_TIMEOUT_S=90
# LLM_HEDGE_AFTER_S=45            # silent this long: also ask the next model, first answer wins
# LLM_HEDGE_AFTER_SHORT_S=20
# LLM_STALL_S=60                  # longest silence once a reply has started
# LLM_MAX_CALLS_PER_RUN=40
#
# Ollama on this Mac (free, offline): brew install ollama && ollama pull qwen3:8b
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen3:8b

# USDA FoodData Central, free: https://api.data.gov/signup/ (key arrives by email)
USDA_API_KEY=

# Chrome while shopping: auto (hidden; a window opens only to sign in), hidden, or visible (watch it)
BROWSER_MODE=auto
PROFILE_ROOT=profiles
DATABASE_PATH=./mealcart.db
CHECKPOINT_PATH=./checkpoints.db
SINGLE_USER_ID=user_default
